# Copy to .env (repository root) and adjust the paths. .env is not committed.
# de_lora/core/paths.py reads it; variables already set in the environment win.
# The shell recipes and scripts ask paths.py for their locations, so they see
# the same values.

# Root of the ARTIFACTS (datasets/, training/, models/), kept outside the repository.
# (The variable name is inherited from the pt-BR template.)
PTBR_ARTIFACTS=/path/to/artifacts

# Optional (defaults in parentheses):
# BREEZE_TTS_REPO=            # engine checkout (the root of this repository)
# BREEZE_CKPT=                # base checkpoint (<PTBR_ARTIFACTS>/models/Breeze-TTS-2)
# BREEZE_DATASETS_DIR=        # processed corpora + corpora.json (<PTBR_ARTIFACTS>/datasets)
# BREEZE_TRAINING_DIR=        # codes, splits, runs (<PTBR_ARTIFACTS>/training); the recipes set it per run
# BREEZE_DATASET_DIR=         # single legacy pt-BR corpus (<datasets>/TTS-Portuguese-Corpus)
# BREEZE_PY=                  # Python interpreter (scripts/run.sh: <repo>/.venv/bin/python, else python3)

# Raw source corpora of the German pipeline (defaults under <datasets>/_raw/):
# CML_DE_ROOT=                # cml-tts-german/cml_tts_dataset_german_v0.1 (train/dev/test.csv + audio)
# HUI_GLOB=                   # opendata-iisys-hui/data/train-*.parquet (HUI-Audio-Corpus-German)
# HIFITTS2_ROOT=              # hifitts2 (selected_chapters.jsonl, chapters/, texte.tsv)
# THORSTEN_DIR=               # thorsten-tv44 (TV-2021.02-Neutral/, TV-2022.10-Neutral/ parquet)
# CV_DIR=                     # common-voice-de (tsv/ + archive parts teil.0 .. teil.3)
# BREEZE_WORDS_DIR=           # rare-word lists and coverage reports (<PTBR_ARTIFACTS>)

# The following are read by the shell scripts only - set them in the environment,
# not here: LOG_DIR, CPU_PIN, ADAPTER_BYTES, BREEZE_CPP_DIR, GGUF_DIR, ACTIVE_NAME,
# RESTART_CMD, HEALTH_URL, TTS_URL, TEST_VOICES, LISTEN_DIR, MIOPEN_USER_DB_PATH
# (see README.md).

# Keys used only by the pt-BR podcast scraping pipeline (de_lora/scraping); those
# scripts read them from <PTBR_ARTIFACTS>/.env, not from this file:
# XAI_TRANSCRIBE_KEY=
# HF_TOKEN=
